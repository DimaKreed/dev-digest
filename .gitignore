node_modules/
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
clones/
playwright-report/
test-results/

# emdash worktree config (local)
.emdash.json

# Skill-sample archives are built on demand from the folders beside them
# (node scripts/make-skill-sample.mjs), so the binary never enters git.
docs/skill-samples/*.zip

# Personal Claude Code overrides. Ignored deliberately: untracked files are part of the
# pr-self-review fingerprint, so a stray settings file would make the gate's own configuration
# part of what the gate reviews. See .claude/hooks/README.md.
.claude/settings.local.json
